<%- include('partials/head', { pageTitle: 'Fusée & R&D — EriniumFaction Wiki' }) %>
<style>
    :root {
      --erina-purple:        #7B2FBE;
      --erina-cyan:          #00E5FF;
      --erina-gold:          #FFD700;
      --valterite:           #4AE0E0;
      --aetherite:           #9B59B6;
      --erinium:             #FFD700;
    }

    .hero-erina-rnd {
      background: linear-gradient(135deg,
        rgba(0, 229, 255, 0.14) 0%,
        rgba(123, 47, 190, 0.10) 50%,
        rgba(255, 215, 0, 0.06) 100%);
      position: relative;
      overflow: hidden;
    }
    .hero-erina-rnd::after {
      content: '🚀';
      position: absolute;
      top: 15%; right: 8%;
      font-size: 6rem;
      opacity: 0.10;
      transform: rotate(-15deg);
      pointer-events: none;
    }

    /* ── Section header ── */
    .rnd-section-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin: 42px 0 18px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--glass-border);
    }
    .rnd-section-icon { font-size: 1.8rem; }
    .rnd-section-header h2 { margin: 0 !important; }

    /* ── Step list ── */
    .step-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin: 18px 0;
    }
    .step-item {
      display: flex;
      gap: 16px;
      align-items: flex-start;
      padding: 16px 18px;
      background: rgba(0, 229, 255, 0.04);
      border: 1px solid rgba(0, 229, 255, 0.18);
      border-radius: var(--radius-md);
      transition: transform var(--transition);
    }
    .step-item:hover { transform: translateX(4px); }
    .step-num {
      width: 36px; height: 36px;
      flex-shrink: 0;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--erina-purple), var(--erina-cyan));
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      font-size: 1rem;
      color: #fff;
      box-shadow: 0 0 14px rgba(0,229,255,0.35);
    }
    .step-content { flex: 1; }
    .step-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 4px;
    }
    .step-desc {
      font-size: 0.82rem;
      color: var(--text-muted);
      line-height: 1.55;
    }
    .step-craft {
      margin-top: 8px;
      font-size: 0.74rem;
      color: var(--text-faint);
      font-family: 'JetBrains Mono', monospace;
      padding: 6px 10px;
      background: rgba(0,0,0,0.20);
      border-radius: var(--radius-md);
      display: inline-block;
    }

    /* ── Components grid (5 pieces fusee) ── */
    .components-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(220px, 1fr));
      gap: 14px;
      margin: 18px 0;
    }
    .component-card {
      background: var(--glass-bg);
      backdrop-filter: var(--blur-glass);
      -webkit-backdrop-filter: var(--blur-glass);
      border: 1px solid var(--glass-border);
      border-left: 3px solid var(--erina-cyan);
      border-radius: var(--radius-md);
      padding: 16px 16px 14px;
      transition: transform var(--transition), box-shadow var(--transition);
    }
    .component-card:hover {
      transform: translateY(-3px);
      box-shadow: 0 6px 20px rgba(0,229,255,0.20);
    }
    .component-icon { font-size: 1.6rem; margin-bottom: 6px; }
    .component-png {
      width: 56px;
      height: 56px;
      image-rendering: pixelated;
      image-rendering: -moz-crisp-edges;
      image-rendering: crisp-edges;
      margin-bottom: 8px;
      filter: drop-shadow(0 0 8px rgba(0,229,255,0.45));
    }
    .rnd-item-png {
      width: 28px;
      height: 28px;
      image-rendering: pixelated;
      image-rendering: -moz-crisp-edges;
      image-rendering: crisp-edges;
      vertical-align: middle;
      margin-right: 6px;
      filter: drop-shadow(0 0 4px rgba(0,229,255,0.35));
    }
    .wiki-inline-icon {
      width: 18px;
      height: 18px;
      image-rendering: pixelated;
      image-rendering: -moz-crisp-edges;
      image-rendering: crisp-edges;
      vertical-align: middle;
      filter: drop-shadow(0 0 4px rgba(0,229,255,0.35));
    }
    .component-name {
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 4px;
    }
    .component-qty {
      display: inline-block;
      font-size: 0.66rem;
      font-weight: 700;
      color: var(--erina-cyan);
      background: rgba(0,229,255,0.10);
      border: 1px solid rgba(0,229,255,0.30);
      padding: 2px 8px;
      border-radius: 100px;
      margin-bottom: 6px;
    }
    .component-craft {
      font-size: 0.74rem;
      color: var(--text-muted);
      line-height: 1.5;
    }

    /* ── Stats banner ── */
    .stats-banner {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(140px, 1fr));
      gap: 0;
      background: var(--glass-bg);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-xl);
      overflow: hidden;
      margin: 22px 0;
    }
    .stats-banner-item {
      padding: 18px 14px;
      text-align: center;
      border-right: 1px solid var(--glass-border);
    }
    .stats-banner-item:last-child { border-right: none; }
    .stats-banner-val {
      font-size: 1.6rem;
      font-weight: 900;
      letter-spacing: -0.04em;
      background: linear-gradient(135deg, var(--erina-purple), var(--erina-cyan));
      -webkit-background-clip: text;
      background-clip: text;
      -webkit-text-fill-color: transparent;
    }
    .stats-banner-label {
      font-size: 0.62rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.08em;
      color: var(--text-faint);
      margin-top: 4px;
    }

    /* ── R&D explanation ── */
    .rnd-info {
      background: var(--glass-bg);
      backdrop-filter: var(--blur-glass);
      -webkit-backdrop-filter: var(--blur-glass);
      border: 1px solid var(--glass-border);
      border-left: 3px solid var(--erina-gold);
      border-radius: var(--radius-lg);
      padding: 22px 24px;
      margin: 22px 0;
    }
    .rnd-info h3 {
      margin-top: 0 !important;
      color: var(--erina-gold);
      font-size: 1.05rem;
      display: flex;
      align-items: center;
      gap: 10px;
    }

    /* ── R&D categories ── */
    .rnd-cat {
      margin: 30px 0;
    }
    .rnd-cat-header {
      display: flex;
      align-items: center;
      gap: 12px;
      margin: 30px 0 14px;
    }
    .rnd-cat-icon {
      font-size: 1.5rem;
      flex-shrink: 0;
    }
    .rnd-cat-name {
      font-size: 1.15rem;
      font-weight: 800;
      color: var(--text);
    }
    .rnd-cat-tag {
      margin-left: auto;
      font-size: 0.7rem;
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      color: var(--text-faint);
    }

    .rnd-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(290px, 1fr));
      gap: 14px;
      margin: 12px 0;
    }
    .rnd-item {
      background: var(--glass-bg);
      backdrop-filter: var(--blur-glass);
      -webkit-backdrop-filter: var(--blur-glass);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      padding: 16px 16px 14px;
      transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
      position: relative;
      overflow: hidden;
    }
    .rnd-item:hover { transform: translateY(-3px); }

    .rnd-item--combat   { border-left: 3px solid #E74C3C; }
    .rnd-item--combat:hover   { box-shadow: 0 6px 20px rgba(231,76,60,0.20); }
    .rnd-item--defense  { border-left: 3px solid #3498DB; }
    .rnd-item--defense:hover  { box-shadow: 0 6px 20px rgba(52,152,219,0.20); }
    .rnd-item--explosif { border-left: 3px solid #FF6B35; }
    .rnd-item--explosif:hover { box-shadow: 0 6px 20px rgba(255,107,53,0.22); }
    .rnd-item--infra    { border-left: 3px solid var(--erina-gold); }
    .rnd-item--infra:hover    { box-shadow: 0 6px 20px rgba(255,215,0,0.22); }

    .rnd-item-name {
      font-size: 0.92rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 4px;
    }
    .rnd-item-desc {
      font-size: 0.78rem;
      color: var(--text-muted);
      line-height: 1.55;
      margin-bottom: 10px;
    }
    .rnd-item-cost {
      display: flex;
      gap: 6px;
      flex-wrap: wrap;
    }
    .cost-pill {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 3px 9px;
      border-radius: 100px;
      font-size: 0.7rem;
      font-weight: 700;
    }
    .cost-pill--pr {
      background: rgba(0,229,255,0.10);
      border: 1px solid rgba(0,229,255,0.28);
      color: var(--erina-cyan);
    }
    .cost-pill--money {
      background: rgba(255,215,0,0.10);
      border: 1px solid rgba(255,215,0,0.28);
      color: var(--erina-gold);
    }

    /* ── Tier indicator ── */
    .tier-indicator {
      display: inline-flex;
      align-items: center;
      gap: 4px;
      padding: 2px 8px;
      border-radius: 100px;
      font-size: 0.62rem;
      font-weight: 800;
      letter-spacing: 0.06em;
      text-transform: uppercase;
      margin-left: 6px;
    }
    .tier-t1 { background: rgba(74,224,224,0.14); border: 1px solid rgba(74,224,224,0.35); color: var(--valterite); }
    .tier-t2 { background: rgba(155,89,182,0.12); border: 1px solid rgba(155,89,182,0.32); color: var(--aetherite); }
    .tier-t3 { background: rgba(255,215,0,0.14); border: 1px solid rgba(255,215,0,0.35); color: var(--erinium); }

    /* ── Tip ── */
    .tip {
      display: flex;
      gap: 14px;
      padding: 14px 16px;
      background: rgba(0,229,255,0.06);
      border: 1px solid rgba(0,229,255,0.25);
      border-radius: var(--radius-md);
      margin: 18px 0;
    }
    .tip-icon { font-size: 1.4rem; flex-shrink: 0; }
    .tip-text { font-size: 0.86rem; color: var(--text); line-height: 1.55; }
    .tip-text strong { color: var(--erina-cyan); }
  </style>
</head>
<body>

<div class="floating-particles" aria-hidden="true"></div>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<%- include('partials/sidebar', { currentPage: currentPage }) %>
<%- include('partials/header') %>


<!-- PAGE WRAPPER -->
<div class="page-wrapper">
  <main class="main">

    <!-- HERO -->
    <section class="hero hero-erina-rnd">
      <div class="hero-badge">🚀 Spatial Update — Fusée &amp; R&amp;D</div>
      <h1>Fusée &amp; R&amp;D</h1>
      <p>
        Pour aller sur Érina, il te faut une fusée. Et pour t'imposer en PvP, il te faut la
        Table de R&amp;D — un système de progression personnel pour débloquer des armes et gadgets uniques.
      </p>
      <div class="hero-meta">
        <div class="hero-meta-item">🚀 <strong>5 pièces</strong> à fabriquer</div>
        <div class="hero-meta-item">⛽ <strong>1 Blaze Rod</strong> par voyage</div>
        <div class="hero-meta-item">🔬 <strong>10 PR</strong> par kill PvP</div>
      </div>
    </section>

    <!-- CONTENT -->
    <div class="content has-toc">
      <div class="content-body">
        <div data-toc style="display:none"></div>

        <nav class="breadcrumb" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a>
          <span class="breadcrumb-sep">›</span>
          <a href="/erina">🪐 Érina</a>
          <span class="breadcrumb-sep">›</span>
          <span class="breadcrumb-current">🚀 Fusée &amp; R&amp;D</span>
        </nav>

        <!-- ROCKET MAKER -->
        <section id="rocket-maker">
          <div class="rnd-section-header">
            <span class="rnd-section-icon">🛠️</span>
            <h2>La table Rocket Maker</h2>
          </div>
          <p>
            La <strong>Rocket Maker</strong> est la table qui permet de fabriquer les pièces de la fusée.
            Tu dois la construire en premier.
          </p>
          <div class="step-list">
            <div class="step-item">
              <div class="step-num">1</div>
              <div class="step-content">
                <div class="step-title">Craft de la table</div>
                <div class="step-desc">Rassemble les ressources, puis crafte la table sur un établi classique.</div>
                <div class="step-craft">4 Erinium Block + 1 Nether Star + 2 Diamond Block + 1 Redstone Block + 1 Blaze Rod</div>
              </div>
            </div>
            <div class="step-item">
              <div class="step-num">2</div>
              <div class="step-content">
                <div class="step-title">Pose-la dans ta base</div>
                <div class="step-desc">Place la table dans un endroit sécurisé. Une fois posée, ouvre-la avec un clic droit pour accéder à l'interface.</div>
              </div>
            </div>
          </div>
        </section>

        <!-- COMPOSANTS -->
        <section id="composants">
          <div class="rnd-section-header">
            <span class="rnd-section-icon">🧩</span>
            <h2>Les 5 composants de la fusée</h2>
          </div>
          <p>Une fois la table posée, tu peux fabriquer les <strong>5 pièces</strong> nécessaires à la construction de la fusée.</p>

          <div class="components-grid">

            <div class="component-card">
              <img src="/wiki/img/items/rocket_hull.png" class="component-png" alt="Coque" title="Coque">
              <div class="component-name">Coque</div>
              <span class="component-qty">× 4 requises</span>
              <div class="component-craft">Plaques de métal qui forment la structure extérieure de la fusée.</div>
            </div>

            <div class="component-card">
              <img src="/wiki/img/items/rocket_engine.png" class="component-png" alt="Réacteur" title="Réacteur">
              <div class="component-name">Réacteur</div>
              <span class="component-qty">× 1 requis</span>
              <div class="component-craft">Le cœur propulsif. Brûle le carburant pour décoller.</div>
            </div>

            <div class="component-card">
              <img src="/wiki/img/items/rocket_tank.png" class="component-png" alt="Réservoir" title="Réservoir">
              <div class="component-name">Réservoir</div>
              <span class="component-qty">× 1 requis</span>
              <div class="component-craft">Stocke les Blaze Rods qui servent de carburant.</div>
            </div>

            <div class="component-card">
              <img src="/wiki/img/items/rocket_nav.png" class="component-png" alt="Module Navigation" title="Module Navigation">
              <div class="component-name">Module Navigation</div>
              <span class="component-qty">× 1 requis</span>
              <div class="component-craft">Calcule la trajectoire et oriente la fusée vers Érina.</div>
            </div>

            <div class="component-card">
              <img src="/wiki/img/items/rocket_seat.png" class="component-png" alt="Sièges" title="Sièges">
              <div class="component-name">Sièges</div>
              <span class="component-qty">× 2 requis</span>
              <div class="component-craft">Permettent à 2 joueurs maximum de prendre place dans la fusée.</div>
            </div>

          </div>
        </section>

        <!-- LANCEMENT -->
        <section id="lancement">
          <div class="rnd-section-header">
            <span class="rnd-section-icon">🚀</span>
            <h2>Lancer la fusée</h2>
          </div>
          <p>Une fois les pièces réunies, voici comment partir vers Érina :</p>

          <div class="step-list">
            <div class="step-item">
              <div class="step-num">1</div>
              <div class="step-content">
                <div class="step-title">Place la fusée</div>
                <div class="step-desc">Pose-la sur une surface stable, dans un endroit dégagé (pas sous un toit).</div>
              </div>
            </div>
            <div class="step-item">
              <div class="step-num">2</div>
              <div class="step-content">
                <div class="step-title">Mets le carburant</div>
                <div class="step-desc"><strong>1 Blaze Rod = 1 voyage.</strong> Tu peux en mettre plusieurs si tu veux faire plusieurs allers-retours.</div>
              </div>
            </div>
            <div class="step-item">
              <div class="step-num">3</div>
              <div class="step-content">
                <div class="step-title">Assieds-toi</div>
                <div class="step-desc">Clic droit sur le siège pour t'asseoir. Tu peux emmener un coéquipier (2 joueurs max).</div>
              </div>
            </div>
            <div class="step-item">
              <div class="step-num">4</div>
              <div class="step-content">
                <div class="step-title">Décollage !</div>
                <div class="step-desc">Lance le décollage depuis l'interface. Le voyage démarre, la fusée reste en place après l'atterrissage.</div>
              </div>
            </div>
          </div>

          <div class="stats-banner">
            <div class="stats-banner-item">
              <div class="stats-banner-val">2</div>
              <div class="stats-banner-label">Joueurs max</div>
            </div>
            <div class="stats-banner-item">
              <div class="stats-banner-val">1</div>
              <div class="stats-banner-label">Blaze Rod / voyage</div>
            </div>
            <div class="stats-banner-item">
              <div class="stats-banner-val">∞</div>
              <div class="stats-banner-label">Réutilisable</div>
            </div>
            <div class="stats-banner-item">
              <div class="stats-banner-val">A↔B</div>
              <div class="stats-banner-label">Aller / Retour</div>
            </div>
          </div>
        </section>

        <!-- TABLE R&D -->
        <section id="rnd">
          <div class="rnd-section-header">
            <span class="rnd-section-icon">🔬</span>
            <h2>La Table de R&amp;D</h2>
          </div>
          <p>
            La <strong>Table de R&amp;D</strong> (Recherche &amp; Développement) est le système qui te permet de
            <strong>débloquer des armes, totems, pièges et explosifs uniques</strong>.
          </p>

          <div class="rnd-info">
            <h3>📋 Comment ça marche ?</h3>
            <ul style="line-height:1.8;color:var(--text-muted);">
              <li>Chaque <strong>kill PvP</strong> te rapporte <strong>10 Points de Recherche (PR)</strong>.</li>
              <li>Tu ouvres la table et tu <strong>dépenses PR + Argent</strong> pour débloquer un item.</li>
              <li>Les déblocages sont <strong>personnels</strong> — ils ne sont pas partagés avec ta faction.</li>
              <li>Une fois un item débloqué, tu peux le crafter à volonté tant que tu as les ressources.</li>
            </ul>
          </div>

          <!-- COMBAT -->
          <div class="rnd-cat">
            <div class="rnd-cat-header">
              <span class="rnd-cat-icon">⚔️</span>
              <span class="rnd-cat-name">Catégorie Combat</span>
              <span class="rnd-cat-tag">Armes &amp; Capacités PvP</span>
            </div>
            <div class="rnd-grid">

              <div class="rnd-item rnd-item--combat">
                <div class="rnd-item-name"><img src="/wiki/img/items/resurrection_anchor.png" class="rnd-item-png" alt="Ancre de Résurrection">Ancre de Résurrection</div>
                <div class="rnd-item-desc">Pose une ancre. Si tu meurs dans les 30 minutes, tu respawn directement à l'ancre.</div>
                <div class="rnd-item-cost">
                  <span class="cost-pill cost-pill--pr">500 PR</span>
                  <span class="cost-pill cost-pill--money">5 000 $</span>
                </div>
              </div>

              <div class="rnd-item rnd-item--combat">
                <div class="rnd-item-name"><img src="/wiki/img/items/erinium_flare.png" class="rnd-item-png" alt="Flare d'Erinium">Flare d'Erinium</div>
                <div class="rnd-item-desc">Projectile qui applique <strong>Glowing</strong> sur 50 blocs pendant 8s. Révèle les ennemis invisibles.</div>
                <div class="rnd-item-cost">
                  <span class="cost-pill cost-pill--pr">200 PR</span>
                  <span class="cost-pill cost-pill--money">1 000 $</span>
                </div>
              </div>

              <div class="rnd-item rnd-item--combat">
                <div class="rnd-item-name"><img src="/wiki/img/items/force_shield.png" class="rnd-item-png" alt="Bouclier d'Erinium">Bouclier d'Erinium</div>
                <div class="rnd-item-desc">Déploie un mur protecteur 2×3 blocs pendant 3s. 30 utilisations avant de se casser.</div>
                <div class="rnd-item-cost">
                  <span class="cost-pill cost-pill--pr">600 PR</span>
                  <span class="cost-pill cost-pill--money">5 000 $</span>
                </div>
              </div>

              <div class="rnd-item rnd-item--combat">
                <div class="rnd-item-name"><img src="/wiki/img/items/orb_speed.png" class="rnd-item-png" alt="Orbe de Speed">Orbe de Speed</div>
                <div class="rnd-item-desc">Active <strong>Speed III</strong> pendant quelques secondes. Idéal pour les courses-poursuites.</div>
                <div class="rnd-item-cost">
                  <span class="cost-pill cost-pill--pr">200 PR</span>
                  <span class="cost-pill cost-pill--money">1 000 $</span>
                </div>
              </div>

              <div class="rnd-item rnd-item--combat">
                <div class="rnd-item-name"><img src="/wiki/img/items/orb_jump.png" class="rnd-item-png" alt="Orbe de Saut">Orbe de Saut</div>
                <div class="rnd-item-desc">Te propulse de <strong>15 blocs</strong> en l'air. Pratique pour franchir des obstacles ou esquiver.</div>
                <div class="rnd-item-cost">
                  <span class="cost-pill cost-pill--pr">250 PR</span>
                  <span class="cost-pill cost-pill--money">1 500 $</span>
                </div>
              </div>

              <div class="rnd-item rnd-item--combat">
                <div class="rnd-item-name"><img src="/wiki/img/items/orb_heal.png" class="rnd-item-png" alt="Orbe de Soin">Orbe de Soin</div>
                <div class="rnd-item-desc">Restaure <strong>8 HP</strong> instantanément. Indispensable pour les combats prolongés.</div>
                <div class="rnd-item-cost">
                  <span class="cost-pill cost-pill--pr">300 PR</span>
