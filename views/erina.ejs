<%- include('partials/head', { pageTitle: 'Planète Érina — EriniumFaction Wiki' }) %>
<style>
    :root {
      --erina-purple:        #7B2FBE;
      --erina-purple-rgb:    123, 47, 190;
      --erina-cyan:          #00E5FF;
      --erina-cyan-rgb:      0, 229, 255;
      --erina-gold:          #FFD700;
      --erina-gold-rgb:      255, 215, 0;
    }

    /* ── Hero Erina ── */
    .hero-erina {
      background: linear-gradient(135deg,
        rgba(123, 47, 190, 0.18) 0%,
        rgba(0, 229, 255, 0.10) 50%,
        rgba(255, 215, 0, 0.06) 100%);
      position: relative;
      overflow: hidden;
    }
    .hero-erina::after {
      content: '';
      position: absolute;
      top: -40%; right: -10%;
      width: 60%; height: 180%;
      background: radial-gradient(circle, rgba(123,47,190,0.25), transparent 60%);
      pointer-events: none;
      animation: erina-pulse 6s ease-in-out infinite;
    }
    @keyframes erina-pulse {
      0%, 100% { opacity: 0.6; transform: scale(1); }
      50%      { opacity: 1; transform: scale(1.08); }
    }

    /* ── Section card ── */
    .erina-section {
      background: var(--glass-bg);
      backdrop-filter: var(--blur-glass);
      -webkit-backdrop-filter: var(--blur-glass);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-xl);
      padding: 26px 28px;
      margin: 22px 0;
      position: relative;
      overflow: hidden;
      transition: border-color var(--transition), box-shadow var(--transition);
    }
    .erina-section::before {
      content: '';
      position: absolute;
      top: 0; left: 8%; right: 8%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.20), transparent);
    }
    .erina-section--purple { border-left: 3px solid var(--erina-purple); }
    .erina-section--purple:hover { box-shadow: 0 0 24px rgba(123,47,190,0.18); }
    .erina-section--cyan   { border-left: 3px solid var(--erina-cyan); }
    .erina-section--cyan:hover   { box-shadow: 0 0 24px rgba(0,229,255,0.18); }
    .erina-section--gold   { border-left: 3px solid var(--erina-gold); }
    .erina-section--gold:hover   { box-shadow: 0 0 24px rgba(255,215,0,0.18); }
    .erina-section--danger { border-left: 3px solid #E74C3C; }
    .erina-section--danger:hover { box-shadow: 0 0 24px rgba(231,76,60,0.18); }

    .erina-section h2 {
      display: flex;
      align-items: center;
      gap: 12px;
      font-size: 1.4rem;
      margin-top: 0 !important;
    }
    .erina-section h2 .erina-icon {
      font-size: 1.8rem;
      filter: drop-shadow(0 0 8px rgba(0,229,255,0.4));
    }

    /* ── Mini info grid ── */
    .erina-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 14px;
      margin: 18px 0;
    }
    .erina-grid-item {
      background: rgba(255,255,255,0.03);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-md);
      padding: 14px 16px;
      transition: transform var(--transition), border-color var(--transition);
    }
    .erina-grid-item:hover {
      transform: translateY(-2px);
      border-color: rgba(var(--erina-cyan-rgb), 0.4);
    }
    .erina-grid-item-title {
      font-size: 0.78rem;
      font-weight: 800;
      color: var(--erina-cyan);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 6px;
    }
    .erina-grid-item-desc {
      font-size: 0.82rem;
      color: var(--text-muted);
      line-height: 1.55;
    }

    /* ── Danger card ── */
    .danger-card {
      display: flex;
      align-items: flex-start;
      gap: 14px;
      padding: 16px 18px;
      background: rgba(231,76,60,0.06);
      border: 1px solid rgba(231,76,60,0.25);
      border-left: 3px solid #E74C3C;
      border-radius: var(--radius-md);
      margin: 12px 0;
      transition: transform var(--transition);
    }
    .danger-card:hover { transform: translateX(3px); }
    .danger-card-icon {
      font-size: 1.6rem;
      flex-shrink: 0;
      filter: drop-shadow(0 0 6px rgba(231,76,60,0.5));
    }
    .danger-card-title {
      font-size: 0.95rem;
      font-weight: 800;
      color: #FF7F6E;
      margin-bottom: 4px;
    }
    .danger-card-desc {
      font-size: 0.82rem;
      color: var(--text-muted);
      line-height: 1.55;
    }

    /* ── Step list ── */
    .step-list {
      display: flex;
      flex-direction: column;
      gap: 12px;
      margin: 20px 0;
    }
    .step-item {
      display: flex;
      gap: 16px;
      align-items: flex-start;
      padding: 16px 18px;
      background: rgba(0, 229, 255, 0.04);
      border: 1px solid rgba(0, 229, 255, 0.18);
      border-radius: var(--radius-md);
    }
    .step-num {
      width: 36px; height: 36px;
      flex-shrink: 0;
      border-radius: 50%;
      background: linear-gradient(135deg, var(--erina-purple), var(--erina-cyan));
      display: flex;
      align-items: center;
      justify-content: center;
      font-weight: 900;
      font-size: 1rem;
      color: #fff;
      box-shadow: 0 0 14px rgba(0,229,255,0.35);
    }
    .step-content { flex: 1; }
    .step-title {
      font-size: 0.95rem;
      font-weight: 700;
      color: var(--text);
      margin-bottom: 4px;
    }
    .step-desc {
      font-size: 0.82rem;
      color: var(--text-muted);
      line-height: 1.55;
    }

    /* ── Nav cards (lien vers sous-pages) ── */
    .nav-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(220px, 1fr));
      gap: 16px;
      margin: 24px 0;
    }
    .nav-card {
      display: block;
      text-decoration: none;
      color: inherit;
      background: var(--glass-bg);
      backdrop-filter: var(--blur-glass);
      -webkit-backdrop-filter: var(--blur-glass);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      padding: 22px 20px;
      transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
      position: relative;
      overflow: hidden;
    }
    .nav-card::before {
      content: '';
      position: absolute;
      top: 0; left: 10%; right: 10%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.20), transparent);
    }
    .nav-card:hover {
      transform: translateY(-4px);
      border-color: rgba(var(--erina-cyan-rgb), 0.4);
      box-shadow: 0 8px 28px rgba(0,229,255,0.15);
    }
    .nav-card-icon {
      font-size: 2rem;
      margin-bottom: 10px;
      filter: drop-shadow(0 0 10px rgba(123,47,190,0.5));
    }
    .nav-card-title {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 6px;
    }
    .nav-card-desc {
      font-size: 0.82rem;
      color: var(--text-muted);
      line-height: 1.55;
    }
    .nav-card-arrow {
      display: inline-block;
      margin-top: 10px;
      font-size: 0.8rem;
      color: var(--erina-cyan);
      font-weight: 700;
    }

    /* ── Effect badge ── */
    .effect-badge {
      display: inline-flex;
      align-items: center;
      gap: 6px;
      background: rgba(123,47,190,0.12);
      border: 1px solid rgba(123,47,190,0.30);
      color: #C58FFF;
      padding: 4px 12px;
      border-radius: 100px;
      font-size: 0.76rem;
      font-weight: 700;
      margin: 4px 6px 4px 0;
    }
  </style>
</head>
<body>

<div class="floating-particles" aria-hidden="true"></div>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<%- include('partials/sidebar', { currentPage: currentPage }) %>
<%- include('partials/header') %>


<!-- PAGE WRAPPER -->
<div class="page-wrapper">
  <main class="main">

    <!-- HERO -->
    <section class="hero hero-erina">
      <div class="hero-badge">🪐 Spatial Update</div>
      <h1>Planète Érina</h1>
      <p>
        Au-delà de l'Overworld, Érina t'attend. Une planète alien aux paysages féeriques et hostiles,
        accessible uniquement par fusée. Cristaux, plasma, créatures inconnues — et un PvP sans pitié.
      </p>
      <div class="hero-meta">
        <div class="hero-meta-item">🌌 <strong>12 biomes</strong> uniques</div>
        <div class="hero-meta-item">👾 <strong>13 créatures</strong> exclusives</div>
        <div class="hero-meta-item">⚔️ <strong>Zone PvP</strong> totale</div>
        <div class="hero-meta-item">🚀 <strong>Accès fusée</strong> uniquement</div>
      </div>
    </section>

    <!-- CONTENT -->
    <div class="content has-toc">
      <div class="content-body">
        <div data-toc style="display:none"></div>

        <nav class="breadcrumb" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a>
          <span class="breadcrumb-sep">›</span>
          <span class="breadcrumb-current">🪐 Planète Érina</span>
        </nav>

        <!-- INTRO -->
        <section id="intro" class="erina-section erina-section--purple">
          <h2><span class="erina-icon">🪐</span> C'est quoi la planète Érina ?</h2>
          <p>
            Érina, c'est une <strong>autre planète</strong>. Une dimension alien complètement différente de l'Overworld.
            Quand tu arrives, tu vois un ciel violet, des cristaux qui poussent partout, des créatures bizarres,
            et un sol qui brille la nuit.
          </p>
          <p>
            C'est <strong>l'endroit le plus dangereux</strong> du serveur. Mais aussi le plus riche : tu y trouves
            des ressources rares qui n'existent nulle part ailleurs. Le plasma, l'Erinite, l'Aerium, les Void Fragments...
          </p>
          <div class="erina-grid">
            <div class="erina-grid-item">
              <div class="erina-grid-item-title">🌍 Une dimension</div>
              <div class="erina-grid-item-desc">Comme le Nether ou l'End, mais en 100% custom.</div>
            </div>
            <div class="erina-grid-item">
              <div class="erina-grid-item-title">🚀 Accès limité</div>
              <div class="erina-grid-item-desc">Uniquement en fusée, depuis l'Overworld.</div>
            </div>
            <div class="erina-grid-item">
              <div class="erina-grid-item-title">⚠️ Pas pour les débutants</div>
              <div class="erina-grid-item-desc">Tu peux y mourir vite si tu n'es pas équipé.</div>
            </div>
          </div>
        </section>

        <!-- COMMENT Y ALLER -->
        <section id="acces" class="erina-section erina-section--cyan">
          <h2><span class="erina-icon">🚀</span> Comment y aller ?</h2>
          <p>Pour rejoindre Érina, il faut <strong>une fusée</strong>. Voici les étapes :</p>
          <div class="step-list">
            <div class="step-item">
              <div class="step-num">1</div>
              <div class="step-content">
                <div class="step-title">Construis la table Rocket Maker</div>
                <div class="step-desc">Cette table sert à fabriquer les pièces de la fusée. Le craft demande des blocs Erinium, une Nether Star et des blocs de diamant.</div>
              </div>
            </div>
            <div class="step-item">
              <div class="step-num">2</div>
              <div class="step-content">
                <div class="step-title">Fabrique les 5 pièces de la fusée</div>
                <div class="step-desc">Coque (x4), Réacteur, Réservoir, Module de Navigation, Sièges (x2). Chaque pièce a son propre craft.</div>
              </div>
            </div>
            <div class="step-item">
              <div class="step-num">3</div>
              <div class="step-content">
                <div class="step-title">Assemble la fusée</div>
                <div class="step-desc">Pose les pièces ensemble dans le monde pour former la fusée complète.</div>
              </div>
            </div>
            <div class="step-item">
              <div class="step-num">4</div>
              <div class="step-content">
                <div class="step-title">Mets du carburant</div>
                <div class="step-desc">Le carburant, c'est <strong>1 Blaze Rod par voyage</strong>. Tu peux en mettre plusieurs pour plusieurs voyages.</div>
              </div>
            </div>
            <div class="step-item">
              <div class="step-num">5</div>
              <div class="step-content">
                <div class="step-title">Décolle !</div>
                <div class="step-desc">Clic droit sur le siège pour t'asseoir, puis lance le décollage. La fusée peut emmener jusqu'à <strong>2 joueurs</strong>.</div>
              </div>
            </div>
          </div>
          <p style="margin-top:18px;">
            <a href="/erina-rnd" style="color:var(--erina-cyan);font-weight:700;">→ Tous les détails sur la fusée et la R&D</a>
          </p>
        </section>

        <!-- RÈGLES SPÉCIALES -->
        <section id="regles" class="erina-section erina-section--gold">
          <h2><span class="erina-icon">⚖️</span> Règles spéciales d'Érina</h2>
          <p>Érina, ce n'est pas comme l'Overworld. Voici ce qui change :</p>
          <div class="erina-grid">
            <div class="erina-grid-item">
              <div class="erina-grid-item-title">⚔️ Zone PvP totale</div>
              <div class="erina-grid-item-desc">Pas de claim possible. Tout le monde peut t'attaquer, partout, tout le temps.</div>
            </div>
            <div class="erina-grid-item">
              <div class="erina-grid-item-title">🚫 Pas de téléportation</div>
              <div class="erina-grid-item-desc">Les commandes <code>/home</code>, <code>/tpa</code> et <code>/warp</code> sont bloquées sur Érina (sauf items spéciaux).</div>
            </div>
            <div class="erina-grid-item">
              <div class="erina-grid-item-title">💀 Mort = drop total</div>
              <div class="erina-grid-item-desc">Si tu meurs sur Érina, tu drop <strong>tout ton loot Érina</strong>. Fais attention !</div>
            </div>
            <div class="erina-grid-item">
              <div class="erina-grid-item-title">🌀 Retour difficile</div>
              <div class="erina-grid-item-desc">Pour rentrer en Overworld, il faut soit reprendre la fusée, soit utiliser un Portail de Retour.</div>
            </div>
          </div>
        </section>

        <!-- EFFETS PERMANENTS -->
        <section id="effets" class="erina-section erina-section--purple">
          <h2><span class="erina-icon">✨</span> Effets permanents</h2>
          <p>
            La gravité et l'atmosphère d'Érina sont différentes. Tu reçois automatiquement
            des <strong>effets passifs</strong> dès que tu poses le pied sur la planète :
          </p>
          <div style="margin: 16px 0;">
            <span class="effect-badge">🦘 Jump Boost I (constant)</span>
            <span class="effect-badge">🪂 -30% dégâts de chute</span>
            <span class="effect-badge">🌅 Lumière crépusculaire permanente</span>
          </div>
          <p style="font-size:0.85rem;color:var(--text-muted);margin-top:12px;">
            La gravité plus faible te permet de sauter plus haut et d'amortir tes chutes.
            Et le ciel d'Érina est toujours dans une lumière douce, ni jour ni nuit.
          </p>
        </section>

        <!-- DANGERS -->
        <section id="dangers" class="erina-section erina-section--danger">
          <h2><span class="erina-icon">⚠️</span> Dangers atmosphériques</h2>
          <p>
            Certaines zones d'Érina sont <strong>mortelles</strong> sans la bonne combinaison spatiale.
            Lis bien cette section avant d'explorer !
          </p>
          <div class="danger-card">
            <div class="danger-card-icon">🏔️</div>
            <div>
              <div class="danger-card-title">Void Peaks (Y &gt; 140)</div>
              <div class="danger-card-desc">Si tu montes au-dessus de Y=140 <strong>sans ton Casque Spatial</strong>, tu reçois <strong>Wither I</strong> en continu. Tu meurs vite.</div>
            </div>
          </div>
          <div class="danger-card">
            <div class="danger-card-icon">❄️</div>
            <div>
              <div class="danger-card-title">Crystal Tundra (zones froides)</div>
              <div class="danger-card-desc">Sans tes <strong>Jambières Spatiales</strong>, le froid te fait perdre ½ cœur toutes les 30 secondes.</div>
            </div>
          </div>
          <div class="danger-card">
            <div class="danger-card-icon">💧</div>
            <div>
              <div class="danger-card-title">Plasma liquide</div>
              <div class="danger-card-desc">Marcher dans le plasma applique <strong>Slowness III</strong> et te fait perdre <strong>½ cœur par seconde</strong>. Sans Bottes Spatiales !</div>
            </div>
          </div>
          <div class="danger-card">
            <div class="danger-card-icon">☣️</div>
            <div>
              <div class="danger-card-title">Toxic Jungle</div>
              <div class="danger-card-desc">L'air est toxique. Sans ton <strong>Plastron Spatial</strong>, tu reçois Poison en continu.</div>
            </div>
          </div>
          <p style="margin-top:18px;">
            <a href="/erina-items" style="color:var(--erina-cyan);font-weight:700;">→ Voir la combinaison spatiale</a>
          </p>
        </section>

        <!-- NAVIGATION -->
        <section id="explore">
          <h2 style="margin-top:40px;">📚 Explore en détail</h2>
          <p>Choisis une catégorie pour en savoir plus :</p>
          <div class="nav-grid">
            <a href="/erina-biomes" class="nav-card">
              <div class="nav-card-icon">🌌</div>
              <div class="nav-card-title">Biomes</div>
              <div class="nav-card-desc">Les 12 biomes d'Érina, des Crystal Plains aux Void Peaks.</div>
              <span class="nav-card-arrow">Découvrir →</span>
            </a>
            <a href="/erina-mobs" class="nav-card">
              <div class="nav-card-icon">👾</div>
              <div class="nav-card-title">Créatures</div>
              <div class="nav-card-desc">13 mobs alien : passifs, hostiles et élites. HP, attaques, drops.</div>
              <span class="nav-card-arrow">Affronter →</span>
            </a>
            <a href="/erina-items" class="nav-card">
              <div class="nav-card-icon">🎒</div>
              <div class="nav-card-title">Items</div>
              <div class="nav-card-desc">Combinaison spatiale, drones, conteneurs dimensionnels...</div>
              <span class="nav-card-arrow">Équiper →</span>
            </a>
            <a href="/erina-rnd" class="nav-card">
              <div class="nav-card-icon">🚀</div>
              <div class="nav-card-title">Fusée &amp; R&amp;D</div>
              <div class="nav-card-desc">Construire la fusée et débloquer les items de combat avancés.</div>
              <span class="nav-card-arrow">Construire →</span>
            </a>
          </div>
        </section>

      </div>

      <!-- TOC -->
      <aside class="toc">
        <div class="toc-title">Sur cette page</div>
        <ul class="toc-list">
          <li class="toc-item"><a href="#intro" class="toc-link">🪐 C'est quoi Érina ?</a></li>
          <li class="toc-item"><a href="#acces" class="toc-link">🚀 Comment y aller ?</a></li>
          <li class="toc-item"><a href="#regles" class="toc-link">⚖️ Règles spéciales</a></li>
          <li class="toc-item"><a href="#effets" class="toc-link">✨ Effets permanents</a></li>
          <li class="toc-item"><a href="#dangers" class="toc-link">⚠️ Dangers</a></li>
          <li class="toc-item"><a href="#explore" class="toc-link">📚 Explore en détail</a></li>
        </ul>
      </aside>
    </div>

  </main>
</div>

<%- include('partials/footer') %>
