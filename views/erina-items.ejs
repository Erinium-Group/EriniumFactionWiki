              <div class="item-card-header">
                <img src="/wiki/img/blocks/plasma_extractor.png" class="item-card-png" alt="Extracteur de Plasma" title="Extracteur de Plasma">
                <div class="item-card-name">Extracteur de Plasma</div>
              </div>
