<!-- PAGE WRAPPER -->
<div class="page-wrapper">
  <main class="main">

    <!-- HERO -->
    <section class="hero hero-erina-items">
      <div class="hero-badge">🎒 Spatial Update — Items</div>
      <h1>Items d'Érina</h1>
      <p>
        Pour explorer Érina en sécurité, tu auras besoin de matériel spécial.
        Combinaison spatiale, drones, conteneurs dimensionnels, beacons de faction...
        Voici tout ce que tu peux fabriquer dès maintenant.
      </p>
      <div class="hero-meta">
        <div class="hero-meta-item">🛡️ <strong>4 pièces</strong> de combinaison</div>
        <div class="hero-meta-item">🎒 <strong>10 items</strong> utilitaires</div>
        <div class="hero-meta-item">🧱 <strong>2 blocs</strong> spéciaux</div>
      </div>
    </section>

    <!-- CONTENT -->
    <div class="content has-toc">
      <div class="content-body">
        <div data-toc style="display:none"></div>

        <nav class="breadcrumb" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a>
          <span class="breadcrumb-sep">›</span>
          <a href="/erina">🪐 Érina</a>
          <span class="breadcrumb-sep">›</span>
          <span class="breadcrumb-current">🎒 Items</span>
        </nav>

        <!-- COMBINAISON -->
        <section id="combinaison">
          <div class="erina-section-header">
            <span class="erina-section-icon">🛡️</span>
            <h2>Combinaison Spatiale</h2>
          </div>
          <p>
            La combinaison spatiale est <strong>obligatoire</strong> pour survivre dans les biomes extrêmes d'Érina.
            Chaque pièce te protège contre un danger spécifique.
          </p>
          <div class="tip">
            <span class="tip-icon">💡</span>
            <div class="tip-text">
              <strong>Astuce :</strong> tu peux porter les pièces individuellement, mais le <strong>set complet</strong> donne un bonus en plus.
            </div>
          </div>

          <div class="suit-grid">

            <div class="suit-piece">
              <img src="/wiki/img/items/space_helmet.png" class="suit-png" alt="Casque Spatial">
              <div class="suit-name">Casque Spatial</div>
              <div class="suit-effect">Protège du Wither I quand tu montes au-dessus de Y=140</div>
              <div class="suit-craft">
                <strong>Craft</strong>
                4 <img src="/wiki/img/items/aerium.png" class="wiki-inline-icon" alt=""> Aerium + 1 <img src="/wiki/img/items/cryo_crystal.png" class="wiki-inline-icon" alt=""> Cryo-Cristal
              </div>
            </div>

            <div class="suit-piece">
              <img src="/wiki/img/items/space_chestplate.png" class="suit-png" alt="Plastron Spatial">
              <div class="suit-name">Plastron Spatial</div>
              <div class="suit-effect">Bloque le Poison de la Toxic Jungle</div>
              <div class="suit-craft">
                <strong>Craft</strong>
                4 <img src="/wiki/img/items/aerium.png" class="wiki-inline-icon" alt=""> Aerium + 2 <img src="/wiki/img/items/solid_plasma.png" class="wiki-inline-icon" alt=""> Plasma Solidifié + 1 <img src="/wiki/img/items/erina_crystal.png" class="wiki-inline-icon" alt=""> Cristal
              </div>
            </div>

            <div class="suit-piece">
              <img src="/wiki/img/items/space_leggings.png" class="suit-png" alt="Jambières Spatiales">
              <div class="suit-name">Jambières Spatiales</div>
              <div class="suit-effect">Protège du froid en Crystal Tundra</div>
              <div class="suit-craft">
                <strong>Craft</strong>
                5 <img src="/wiki/img/items/aerium.png" class="wiki-inline-icon" alt=""> Aerium + 2 <img src="/wiki/img/items/erina_crystal.png" class="wiki-inline-icon" alt=""> Cristal
              </div>
            </div>

            <div class="suit-piece">
              <img src="/wiki/img/items/space_boots.png" class="suit-png" alt="Bottes Spatiales">
              <div class="suit-name">Bottes Spatiales</div>
              <div class="suit-effect">-80% dégâts plasma + ErinaWalk (jamais de Slowness sur les blocs Erina)</div>
              <div class="suit-craft">
                <strong>Craft</strong>
                2 <img src="/wiki/img/items/aerium.png" class="wiki-inline-icon" alt=""> Aerium + 2 <img src="/wiki/img/items/solid_plasma.png" class="wiki-inline-icon" alt=""> Plasma Solidifié
              </div>
            </div>

          </div>

          <div class="set-bonus">
            <span class="set-bonus-icon">✨</span>
            <div class="set-bonus-text">
              <strong>Bonus Set complet :</strong> en portant les 4 pièces ensemble, tu gagnes
              <strong>Feather Falling II</strong> en bonus. Tes chutes deviennent presque indolores !
            </div>
          </div>
        </section>

        <!-- ITEMS UTILITAIRES -->
        <section id="utilitaires">
          <div class="erina-section-header">
            <span class="erina-section-icon">🎒</span>
            <h2>Items utilitaires</h2>
          </div>
          <p>10 items spéciaux pour t'aider à explorer, transporter du loot, ou piéger tes adversaires.</p>

          <div class="item-grid">

            <div class="item-card">
              <div class="item-card-header">
                <img src="/wiki/img/items/loot_amplifier.png" class="item-card-png" alt="Amplificateur de Drop">
                <div class="item-card-name">Amplificateur de Drop</div>
              </div>
              <div class="item-card-desc">Active un effet qui <strong>double les drops</strong> de tous les minerais d'Érina pendant 5 minutes. Indispensable pour les sessions de farming.</div>
              <div class="item-card-craft">
                <strong>Craft</strong>
                2 <img src="/wiki/img/items/luminous_spore.png" class="wiki-inline-icon" alt=""> Spore + 2 <img src="/wiki/img/items/plasma_pearl.png" class="wiki-inline-icon" alt=""> Perle Plasma + 1 <img src="/wiki/img/items/erina_crystal.png" class="wiki-inline-icon" alt=""> Cristal
              </div>
            </div>

            <div class="item-card">
              <div class="item-card-header">
                <img src="/wiki/img/items/return_portal.png" class="item-card-png" alt="Portail de Retour">
                <div class="item-card-name">Portail de Retour</div>
              </div>
              <div class="item-card-desc">Place un portail violet pendant 30 secondes pour <strong>revenir en Overworld</strong> (ou aller sur Érina depuis l'Overworld). Solution d'urgence !</div>
              <div class="item-card-craft">
                <strong>Craft</strong>
                4 <img src="/wiki/img/items/echo_stone.png" class="wiki-inline-icon" alt=""> Echo Stone + 4 Ender Pearl + 1 <img src="/wiki/img/items/erina_crystal.png" class="wiki-inline-icon" alt=""> Cristal
              </div>
            </div>

            <div class="item-card">
              <div class="item-card-header">
                <img src="/wiki/img/items/drone.png" class="item-card-png" alt="Drone d'Exploration">
                <div class="item-card-name">Drone d'Exploration</div>
              </div>
              <div class="item-card-desc">Lance un drone qui vole 200 blocs droit devant toi. Il applique <strong>Glowing</strong> sur tous les joueurs à moins de 2 blocs de sa trajectoire. Parfait pour repérer les ennemis.</div>
              <div class="item-card-craft">
                <strong>Craft</strong>
                2 <img src="/wiki/img/items/aerium.png" class="wiki-inline-icon" alt=""> Aerium + 2 <img src="/wiki/img/items/echo_stone.png" class="wiki-inline-icon" alt=""> Echo Stone + 1 <img src="/wiki/img/items/erina_crystal.png" class="wiki-inline-icon" alt=""> Cristal
              </div>
            </div>

            <div class="item-card">
              <div class="item-card-header">
                <img src="/wiki/img/items/signal_scrambler.png" class="item-card-png" alt="Brouilleur de Signal">
                <div class="item-card-name">Brouilleur de Signal</div>
              </div>
              <div class="item-card-desc">Bloque <strong>toutes les commandes de TP</strong> (/home, /tpa, /warp) dans un rayon de 30 blocs pendant 60 secondes. L'ennemi ne peut plus s'enfuir.</div>
              <div class="item-card-craft">
                <strong>Craft</strong>
                2 <img src="/wiki/img/items/echo_stone.png" class="wiki-inline-icon" alt=""> Echo Stone + 2 <img src="/wiki/img/items/void_fragment.png" class="wiki-inline-icon" alt=""> Void Fragment + 1 <img src="/wiki/img/items/erina_crystal.png" class="wiki-inline-icon" alt=""> Cristal
              </div>
            </div>

            <div class="item-card">
              <div class="item-card-header">
                <img src="/wiki/img/items/void_container.png" class="item-card-png" alt="Conteneur Dimensionnel">
                <div class="item-card-name">Conteneur Dimensionnel</div>
              </div>
              <div class="item-card-desc">Coffre portable de <strong>27 slots</strong> intégré à l'item. Le contenu est <strong>sauvegardé même à la mort</strong>. Idéal pour transporter du loot précieux.</div>
              <div class="item-card-craft">
                <strong>Craft</strong>
                4 <img src="/wiki/img/items/void_fragment.png" class="wiki-inline-icon" alt=""> Void Fragment + 4 Ender Pearl + 1 <img src="/wiki/img/items/erina_crystal.png" class="wiki-inline-icon" alt=""> Cristal
              </div>
            </div>

            <div class="item-card">
              <div class="item-card-header">
                <img src="/wiki/img/items/mine_proximity_detector.png" class="item-card-png" alt="Piège à Ombre">
                <div class="item-card-name">Piège à Ombre</div>
              </div>
              <div class="item-card-desc">Pose un piège <strong>invisible aux ennemis</strong>. Quand quelqu'un marche dessus : téléportation aléatoire dans 10 blocs + Blindness 2s. Chaos garanti !</div>
              <div class="item-card-craft">
                <strong>Craft</strong>
                2 <img src="/wiki/img/items/void_fragment.png" class="wiki-inline-icon" alt=""> Void Fragment + 2 <img src="/wiki/img/items/echo_stone.png" class="wiki-inline-icon" alt=""> Echo Stone + 1 Ender Pearl
              </div>
            </div>

            <div class="item-card">
              <div class="item-card-header">
                <img src="/wiki/img/items/stability_fragment.png" class="item-card-png" alt="Fragment de Stabilité">
                <div class="item-card-name">Fragment de Stabilité</div>
              </div>
              <div class="item-card-desc">Répare n'importe quel item à <strong>50% de durabilité max</strong>. Limite : 1 fois par item toutes les 24h réelles.</div>
              <div class="item-card-craft">
                <strong>Obtention</strong>
                Craft ou drops divers
              </div>
            </div>

            <div class="item-card">
              <div class="item-card-header">
                <img src="/wiki/img/items/vision_mushroom.png" class="item-card-png" alt="Champignon de Vision">
                <div class="item-card-name">Champignon de Vision</div>
              </div>
              <div class="item-card-desc">Consommable : Night Vision pendant 5 min, et <strong>révèle les joueurs invisibles</strong> dans 30 blocs pendant 10s. Une légère nausée à la fin.</div>
              <div class="item-card-craft">
                <strong>Obtention</strong>
                Drop des Glow Mushrooms (30%)
              </div>
            </div>

            <div class="item-card">
              <div class="item-card-header">
                <img src="/wiki/img/items/telepathy_crystal.png" class="item-card-png" alt="Cristal de Télépathie">
                <div class="item-card-name">Cristal de Télépathie</div>
              </div>
              <div class="item-card-desc">Active un <strong>overlay</strong> qui affiche en permanence la position de tous les membres de ta faction présents sur Érina.</div>
              <div class="item-card-craft">
                <strong>Craft</strong>
                2 <img src="/wiki/img/items/plasma_pearl.png" class="wiki-inline-icon" alt=""> Perle Plasma + 2 <img src="/wiki/img/items/erinite_gem.png" class="wiki-inline-icon" alt=""> Erinite + 1 <img src="/wiki/img/items/erina_crystal.png" class="wiki-inline-icon" alt=""> Cristal
              </div>
            </div>

            <div class="item-card">
              <div class="item-card-header">
                <img src="/wiki/img/items/deployable_camp.png" class="item-card-png" alt="Camp Déployable">
                <div class="item-card-name">Camp Déployable</div>
              </div>
              <div class="item-card-desc">Pose une structure <strong>tente temporaire</strong> avec un point de respawn pour ta faction. Pratique pour sécuriser une zone d'exploration.</div>
              <div class="item-card-craft">
                <strong>Craft</strong>
                5 <img src="/wiki/img/items/compact_ash.png" class="wiki-inline-icon" alt=""> Cendre Compacte + 1 <img src="/wiki/img/items/erina_crystal.png" class="wiki-inline-icon" alt=""> Cristal + 1 <img src="/wiki/img/items/impact_core.png" class="wiki-inline-icon" alt=""> Noyau d'Impact
              </div>
            </div>

          </div>
        </section>

        <!-- BLOCS SPÉCIAUX -->
        <section id="blocs">
