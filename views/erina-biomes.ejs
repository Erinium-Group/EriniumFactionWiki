<%- include('partials/head', { pageTitle: 'Biomes d\'Érina — EriniumFaction Wiki' }) %>
<style>
    :root {
      --erina-purple:        #7B2FBE;
      --erina-cyan:          #00E5FF;
      --erina-gold:          #FFD700;
    }

    .hero-erina-biomes {
      background: linear-gradient(135deg,
        rgba(123, 47, 190, 0.18) 0%,
        rgba(0, 229, 255, 0.10) 50%,
        transparent 100%);
    }

    /* ── Biome card ── */
    .biome-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
      gap: 16px;
      margin: 22px 0 32px;
    }
    .biome-card {
      background: var(--glass-bg);
      backdrop-filter: var(--blur-glass);
      -webkit-backdrop-filter: var(--blur-glass);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      padding: 20px 18px;
      position: relative;
      overflow: hidden;
      transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
    }
    .biome-card::before {
      content: '';
      position: absolute;
      top: 0; left: 10%; right: 10%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.20), transparent);
    }
    .biome-card:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 28px rgba(0,0,0,0.3);
    }

    .biome-icon {
      font-size: 2.2rem;
      margin-bottom: 8px;
      display: inline-block;
      filter: drop-shadow(0 0 10px rgba(0,229,255,0.4));
    }
    .biome-name {
      font-size: 1.05rem;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 4px;
      letter-spacing: -0.01em;
    }
    .biome-y {
      font-size: 0.7rem;
      color: var(--text-faint);
      font-weight: 700;
      letter-spacing: 0.05em;
      margin-bottom: 10px;
    }
    .biome-desc {
      font-size: 0.82rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 12px;
    }
    .biome-stats {
      display: flex;
      flex-direction: column;
      gap: 6px;
      margin-top: 12px;
      padding-top: 12px;
      border-top: 1px solid var(--glass-border);
    }
    .biome-stat-row {
      display: flex;
      align-items: baseline;
      gap: 8px;
      font-size: 0.78rem;
    }
    .biome-stat-label {
      color: var(--text-faint);
      font-weight: 700;
      min-width: 78px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.66rem;
    }
    .biome-stat-val {
      color: var(--text);
      flex: 1;
    }
    .biome-tags {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 10px;
    }
    .biome-tag {
      font-size: 0.62rem;
      font-weight: 700;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      padding: 3px 9px;
      border-radius: 4px;
    }
    .biome-tag--danger {
      background: rgba(231,76,60,0.14);
      border: 1px solid rgba(231,76,60,0.35);
      color: #FF7F6E;
    }
    .biome-tag--safe {
      background: rgba(46,204,113,0.14);
      border: 1px solid rgba(46,204,113,0.35);
      color: #6BE6A0;
    }
    .biome-tag--resource {
      background: rgba(255,215,0,0.14);
      border: 1px solid rgba(255,215,0,0.35);
      color: var(--erina-gold);
    }
    .biome-tag--mob {
      background: rgba(155,89,182,0.14);
      border: 1px solid rgba(155,89,182,0.35);
      color: #C58FFF;
    }

    /* ── Theme borders per biome ── */
    .biome-card--crystal { border-left: 3px solid #00E5FF; }
    .biome-card--crystal:hover { box-shadow: 0 8px 28px rgba(0,229,255,0.22); }
    .biome-card--glow    { border-left: 3px solid #2ECC71; }
    .biome-card--glow:hover    { box-shadow: 0 8px 28px rgba(46,204,113,0.22); }
    .biome-card--echo    { border-left: 3px solid #9B59B6; }
    .biome-card--echo:hover    { box-shadow: 0 8px 28px rgba(155,89,182,0.22); }
    .biome-card--plasma  { border-left: 3px solid #B06EDE; }
    .biome-card--plasma:hover  { box-shadow: 0 8px 28px rgba(176,110,222,0.22); }
    .biome-card--floating{ border-left: 3px solid #F4D03F; }
    .biome-card--floating:hover{ box-shadow: 0 8px 28px rgba(244,208,63,0.22); }
    .biome-card--ash     { border-left: 3px solid #E74C3C; }
    .biome-card--ash:hover     { box-shadow: 0 8px 28px rgba(231,76,60,0.22); }
    .biome-card--tundra  { border-left: 3px solid #87CEEB; }
    .biome-card--tundra:hover  { box-shadow: 0 8px 28px rgba(135,206,235,0.22); }
    .biome-card--toxic   { border-left: 3px solid #2ECC71; }
    .biome-card--toxic:hover   { box-shadow: 0 8px 28px rgba(46,204,113,0.30); }
    .biome-card--impact  { border-left: 3px solid #FF6B35; }
    .biome-card--impact:hover  { box-shadow: 0 8px 28px rgba(255,107,53,0.28); }
    .biome-card--cavern  { border-left: 3px solid #6E5494; }
    .biome-card--cavern:hover  { box-shadow: 0 8px 28px rgba(110,84,148,0.28); }
    .biome-card--void    { border-left: 3px solid #4A148C; }
    .biome-card--void:hover    { box-shadow: 0 8px 28px rgba(74,20,140,0.30); }
    .biome-card--shore   { border-left: 3px solid #00BCD4; }
    .biome-card--shore:hover   { box-shadow: 0 8px 28px rgba(0,188,212,0.22); }

    /* ── Quick tip ── */
    .tip-box {
      display: flex;
      gap: 14px;
      padding: 16px 18px;
      background: rgba(0,229,255,0.06);
      border: 1px solid rgba(0,229,255,0.25);
      border-radius: var(--radius-md);
      margin: 24px 0;
    }
    .tip-box-icon { font-size: 1.5rem; flex-shrink: 0; }
    .tip-box-text { font-size: 0.86rem; color: var(--text); line-height: 1.6; }
    .tip-box-text strong { color: var(--erina-cyan); }
  </style>
</head>
<body>

<div class="floating-particles" aria-hidden="true"></div>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
<%- include('partials/sidebar', { currentPage: currentPage }) %>
<%- include('partials/header') %>


<!-- PAGE WRAPPER -->
<div class="page-wrapper">
  <main class="main">

    <!-- HERO -->
    <section class="hero hero-erina-biomes">
      <div class="hero-badge">🌌 Spatial Update — Biomes</div>
      <h1>Biomes d'Érina</h1>
      <p>
        Érina compte 12 biomes uniques, chacun avec son ambiance, ses ressources et ses dangers.
        Ouvre l'œil avant d'explorer : certains te tuent vite si tu n'as pas le bon équipement.
      </p>
      <div class="hero-meta">
        <div class="hero-meta-item">🌌 <strong>12 biomes</strong> exclusifs</div>
        <div class="hero-meta-item">⚠️ <strong>8</strong> avec dangers</div>
        <div class="hero-meta-item">💎 <strong>10+ ressources</strong> uniques</div>
      </div>
    </section>

    <!-- CONTENT -->
    <div class="content has-toc">
      <div class="content-body">
        <div data-toc style="display:none"></div>

        <nav class="breadcrumb" aria-label="Fil d'Ariane">
          <a href="/">Accueil</a>
          <span class="breadcrumb-sep">›</span>
          <a href="/erina">🪐 Érina</a>
          <span class="breadcrumb-sep">›</span>
          <span class="breadcrumb-current">🌌 Biomes</span>
        </nav>

        <!-- INTRO -->
        <section id="intro">
          <h2>Comment lire ces cartes ?</h2>
          <p>
            Chaque biome a un <strong>niveau de hauteur</strong> (Y) où il est le plus présent,
            une <strong>ressource principale</strong> à récolter, et parfois un <strong>danger spécial</strong>.
            Les badges en bas de chaque carte t'indiquent vite ce que tu peux y trouver.
          </p>
          <div class="tip-box">
            <span class="tip-box-icon">💡</span>
            <div class="tip-box-text">
              <strong>Astuce :</strong> Les biomes les plus rentables sont aussi les plus dangereux.
              Va d'abord sur les <strong>Crystal Plains</strong> (sans danger) pour t'équiper,
              puis pars vers les zones plus risquées.
            </div>
          </div>
        </section>

        <!-- BIOMES SAFES -->
        <section id="safes">
          <h2>🌿 Biomes débutants</h2>
          <p>Ces biomes sont les <strong>plus accessibles</strong>. Aucun effet négatif, parfait pour démarrer ton aventure.</p>
          <div class="biome-grid">

            <div class="biome-card biome-card--crystal">
              <span class="biome-icon">💎</span>
              <div class="biome-name">Crystal Plains</div>
              <div class="biome-y">Niveau Y ~ 76</div>
              <div class="biome-desc">Plaines couvertes de cristaux qui scintillent au soleil. Le biome le plus paisible d'Érina, parfait pour faire ses premières récoltes.</div>
              <div class="biome-stats">
                <div class="biome-stat-row"><span class="biome-stat-label">Ressource</span><span class="biome-stat-val">Cristal d'Erina</span></div>
                <div class="biome-stat-row"><span class="biome-stat-label">Mobs</span><span class="biome-stat-val">Crystallite (passif)</span></div>
              </div>
              <div class="biome-tags">
                <span class="biome-tag biome-tag--safe">Aucun danger</span>
                <span class="biome-tag biome-tag--resource">Cristal</span>
              </div>
            </div>

            <div class="biome-card biome-card--shore">
              <span class="biome-icon">🌊</span>
              <div class="biome-name">Luminous Shore</div>
              <div class="biome-y">Niveau Y ~ 65</div>
              <div class="biome-desc">Côtes lumineuses bordées de plasma. Le sable brille la nuit et reflète les couleurs du ciel violacé.</div>
              <div class="biome-stats">
                <div class="biome-stat-row"><span class="biome-stat-label">Ressource</span><span class="biome-stat-val">Perle de Plasma</span></div>
                <div class="biome-stat-row"><span class="biome-stat-label">Mobs</span><span class="biome-stat-val">Shore Crab (neutre)</span></div>
              </div>
              <div class="biome-tags">
                <span class="biome-tag biome-tag--safe">Plasma à proximité</span>
                <span class="biome-tag biome-tag--resource">Perle Plasma</span>
              </div>
            </div>

          </div>
        </section>

        <!-- BIOMES DE SURFACE -->
        <section id="surface">
          <h2>🏞️ Biomes de surface</h2>
          <p>Tous les biomes accessibles à la surface d'Érina. Chacun a son piège — équipe-toi en conséquence.</p>
          <div class="biome-grid">

            <div class="biome-card biome-card--glow">
              <span class="biome-icon">🍄</span>
              <div class="biome-name">Glow Forest</div>
              <div class="biome-y">Niveau Y ~ 80</div>
              <div class="biome-desc">Forêt magique remplie de champignons lumineux. Les spores qui flottent dans l'air ralentissent les visiteurs imprudents.</div>
              <div class="biome-stats">
                <div class="biome-stat-row"><span class="biome-stat-label">Ressource</span><span class="biome-stat-val">Spore Lumineuse</span></div>
                <div class="biome-stat-row"><span class="biome-stat-label">Mobs</span><span class="biome-stat-val">Sporeling (hostile)</span></div>
              </div>
              <div class="biome-tags">
                <span class="biome-tag biome-tag--danger">Spores : Slowness</span>
                <span class="biome-tag biome-tag--resource">Spore</span>
                <span class="biome-tag biome-tag--mob">Sporeling</span>
              </div>
            </div>

            <div class="biome-card biome-card--echo">
              <span class="biome-icon">🌀</span>
              <div class="biome-name">Echo Canyon</div>
              <div class="biome-y">Niveau Y ~ 46</div>
              <div class="biome-desc">Canyons profonds aux échos étranges. Les parois sont à pic — chuter de 40 blocs ou plus est très dangereux.</div>
              <div class="biome-stats">
                <div class="biome-stat-row"><span class="biome-stat-label">Ressource</span><span class="biome-stat-val">Echo Stone</span></div>
                <div class="biome-stat-row"><span class="biome-stat-label">Mobs</span><span class="biome-stat-val">Echolith</span></div>
              </div>
              <div class="biome-tags">
                <span class="biome-tag biome-tag--danger">Chutes 40+ blocs</span>
                <span class="biome-tag biome-tag--resource">Echo Stone</span>
                <span class="biome-tag biome-tag--mob">Echolith</span>
              </div>
            </div>

            <div class="biome-card biome-card--plasma">
              <span class="biome-icon">💧</span>
              <div class="biome-name">Plasma Swamp</div>
              <div class="biome-y">Niveau Y ~ 63</div>
              <div class="biome-desc">Marais inondés de plasma violet. Le liquide ralentit et brûle ceux qui marchent dedans.</div>
              <div class="biome-stats">
                <div class="biome-stat-row"><span class="biome-stat-label">Ressource</span><span class="biome-stat-val">Plasma Solidifié</span></div>
                <div class="biome-stat-row"><span class="biome-stat-label">Mobs</span><span class="biome-stat-val">Plasma Leech</span></div>
              </div>
              <div class="biome-tags">
                <span class="biome-tag biome-tag--danger">Plasma : Slowness + dégâts</span>
                <span class="biome-tag biome-tag--resource">Plasma Solidifié</span>
                <span class="biome-tag biome-tag--mob">Plasma Leech</span>
              </div>
            </div>

            <div class="biome-card biome-card--floating">
              <span class="biome-icon">🪐</span>
              <div class="biome-name">Floating Plateaus</div>
              <div class="biome-y">Niveau Y ~ 100</div>
              <div class="biome-desc">Plateaux flottants suspendus dans le vide. Vue spectaculaire, mais une mauvaise glissade signifie une chute mortelle.</div>
              <div class="biome-stats">
                <div class="biome-stat-row"><span class="biome-stat-label">Ressource</span><span class="biome-stat-val">Aerium</span></div>
                <div class="biome-stat-row"><span class="biome-stat-label">Mobs</span><span class="biome-stat-val">Plateau Drifter</span></div>
              </div>
              <div class="biome-tags">
                <span class="biome-tag biome-tag--danger">Chutes létales</span>
                <span class="biome-tag biome-tag--resource">Aerium</span>
                <span class="biome-tag biome-tag--mob">Drifter</span>
              </div>
            </div>

            <div class="biome-card biome-card--ash">
              <span class="biome-icon">🌋</span>
              <div class="biome-name">Ash Desert</div>
              <div class="biome-y">Niveau Y ~ 72</div>
              <div class="biome-desc">Désert de cendres grises. Des geysers crachent du gaz toxique de manière imprévisible.</div>
              <div class="biome-stats">
                <div class="biome-stat-row"><span class="biome-stat-label">Ressource</span><span class="biome-stat-val">Cendre Compacte</span></div>
                <div class="biome-stat-row"><span class="biome-stat-label">Mobs</span><span class="biome-stat-val">Ash Lurker</span></div>
              </div>
              <div class="biome-tags">
                <span class="biome-tag biome-tag--danger">Geysers poison</span>
                <span class="biome-tag biome-tag--resource">Cendre</span>
                <span class="biome-tag biome-tag--mob">Ash Lurker</span>
              </div>
            </div>

            <div class="biome-card biome-card--tundra">
              <span class="biome-icon">❄️</span>
              <div class="biome-name">Crystal Tundra</div>
              <div class="biome-y">Niveau Y ~ 82</div>
              <div class="biome-desc">Toundra glaciale aux cristaux gelés. Le froid mord ceux qui n'ont pas leurs jambières spatiales.</div>
              <div class="biome-stats">
                <div class="biome-stat-row"><span class="biome-stat-label">Ressource</span><span class="biome-stat-val">Cryo-Cristal</span></div>
                <div class="biome-stat-row"><span class="biome-stat-label">Mobs</span><span class="biome-stat-val">Frost Crawler</span></div>
              </div>
              <div class="biome-tags">
                <span class="biome-tag biome-tag--danger">Froid : ½ ❤ / 30s</span>
                <span class="biome-tag biome-tag--resource">Cryo-Cristal</span>
                <span class="biome-tag biome-tag--mob">Frost Crawler</span>
              </div>
            </div>

            <div class="biome-card biome-card--toxic">
              <span class="biome-icon">☣️</span>
              <div class="biome-name">Toxic Jungle</div>
              <div class="biome-y">Niveau Y ~ 83</div>
              <div class="biome-desc">Jungle dense et empoisonnée. L'air est saturé de toxines, et les habitants n'ont rien d'amical.</div>
              <div class="biome-stats">
                <div class="biome-stat-row"><span class="biome-stat-label">Ressource</span><span class="biome-stat-val">Toxine d'Erina</span></div>
                <div class="biome-stat-row"><span class="biome-stat-label">Mobs</span><span class="biome-stat-val">Toxic Crawler, Venom Spitter</span></div>
              </div>
              <div class="biome-tags">
                <span class="biome-tag biome-tag--danger">Poison constant</span>
                <span class="biome-tag biome-tag--resource">Toxine</span>
                <span class="biome-tag biome-tag--mob">2 mobs</span>
              </div>
            </div>

          </div>
        </section>

        <!-- BIOMES EXTRÊMES -->
        <section id="extremes">
          <h2>🔥 Biomes extrêmes</h2>
          <p>Ces biomes sont <strong>très dangereux</strong>. Ne tente pas l'aventure sans une combinaison spatiale complète.</p>
          <div class="biome-grid">

            <div class="biome-card biome-card--impact">
              <span class="biome-icon">☄️</span>
              <div class="biome-name">Impact Crater</div>
              <div class="biome-y">Niveau Y ~ 65</div>
              <div class="biome-desc">Cratère unique formé par un astéroïde géant. Lave alien et créatures élites gardent les ressources les plus rares.</div>
              <div class="biome-stats">
                <div class="biome-stat-row"><span class="biome-stat-label">Ressource</span><span class="biome-stat-val">Noyau d'Impact</span></div>
                <div class="biome-stat-row"><span class="biome-stat-label">Mobs</span><span class="biome-stat-val">Impact Brute, Magma Crawler</span></div>
              </div>
              <div class="biome-tags">
                <span class="biome-tag biome-tag--danger">Lave alien + Élites</span>
                <span class="biome-tag biome-tag--resource">Noyau Impact</span>
                <span class="biome-tag biome-tag--mob">Élites</span>
              </div>
            </div>

            <div class="biome-card biome-card--cavern">
              <span class="biome-icon">🕳️</span>
              <div class="biome-name">Crystal Caverns</div>
              <div class="biome-y">Niveau Y &lt; 40</div>
              <div class="biome-desc">Souterrain labyrinthique creusé sous Érina. Obscurité totale et minerais d'Erinite à profusion.</div>
              <div class="biome-stats">
                <div class="biome-stat-row"><span class="biome-stat-label">Ressource</span><span class="biome-stat-val">Minerai d'Erinite</span></div>
                <div class="biome-stat-row"><span class="biome-stat-label">Mobs</span><span class="biome-stat-val">Frost Crawler, Crystal Golem</span></div>
              </div>
              <div class="biome-tags">
                <span class="biome-tag biome-tag--danger">Obscurité, labyrinthe</span>
                <span class="biome-tag biome-tag--resource">Erinite</span>
                <span class="biome-tag biome-tag--mob">Élite</span>
              </div>
            </div>

            <div class="biome-card biome-card--void">
              <span class="biome-icon">🏔️</span>
              <div class="biome-name">Void Peaks</div>
              <div class="biome-y">Niveau Y ~ 130</div>
              <div class="biome-desc">Pics extrêmes qui frôlent le vide cosmique. Au-delà de Y=140, tu as besoin de ton casque sinon tu meurs.</div>
              <div class="biome-stats">
                <div class="biome-stat-row"><span class="biome-stat-label">Ressource</span><span class="biome-stat-val">Void Fragment</span></div>
                <div class="biome-stat-row"><span class="biome-stat-label">Mobs</span><span class="biome-stat-val">Void Shade</span></div>
              </div>
              <div class="biome-tags">
                <span class="biome-tag biome-tag--danger">Wither I &gt;Y140</span>
                <span class="biome-tag biome-tag--resource">Void Fragment</span>
                <span class="biome-tag biome-tag--mob">Void Shade</span>
              </div>
            </div>

          </div>
        </section>

        <!-- LIENS -->
        <section id="liens">
          <h2 style="margin-top:32px;">🔗 Pour aller plus loin</h2>
          <div class="tip-box">
            <span class="tip-box-icon">👾</span>
            <div class="tip-box-text">
              Tu veux savoir <strong>quel mob habite chaque biome</strong> en détail ?
              <a href="/erina-mobs" style="color:var(--erina-cyan);font-weight:700;">→ Voir la page Créatures</a>
            </div>
          </div>
          <div class="tip-box">
            <span class="tip-box-icon">🎒</span>
            <div class="tip-box-text">
              Pour survivre aux biomes extrêmes, il te faut une combinaison spatiale.
              <a href="/erina-items" style="color:var(--erina-cyan);font-weight:700;">→ Voir la page Items</a>
            </div>
          </div>
        </section>

      </div>

      <!-- TOC -->
      <aside class="toc">
        <div class="toc-title">Sur cette page</div>
        <ul class="toc-list">
          <li class="toc-item"><a href="#intro" class="toc-link">Comment lire les cartes</a></li>
          <li class="toc-item"><a href="#safes" class="toc-link">🌿 Biomes débutants</a></li>
          <li class="toc-item"><a href="#surface" class="toc-link">🏞️ Biomes de surface</a></li>
          <li class="toc-item"><a href="#extremes" class="toc-link">🔥 Biomes extrêmes</a></li>
          <li class="toc-item"><a href="#liens" class="toc-link">🔗 Pour aller plus loin</a></li>
        </ul>
      </aside>
    </div>

  </main>
</div>

<%- include('partials/footer') %>
