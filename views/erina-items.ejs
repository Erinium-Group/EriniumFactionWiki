<%- include('partials/head', { pageTitle: 'Items d\'Érina — EriniumFaction Wiki' }) %>
<style>
    :root {
      --erina-purple:        #7B2FBE;
      --erina-cyan:          #00E5FF;
      --erina-gold:          #FFD700;
    }

    .hero-erina-items {
      background: linear-gradient(135deg,
        rgba(255, 215, 0, 0.12) 0%,
        rgba(123, 47, 190, 0.10) 50%,
        rgba(0, 229, 255, 0.06) 100%);
    }

    /* ── Section header ── */
    .erina-section-header {
      display: flex;
      align-items: center;
      gap: 14px;
      margin: 42px 0 18px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--glass-border);
    }
    .erina-section-icon { font-size: 1.8rem; }
    .erina-section-header h2 { margin: 0 !important; }

    /* ── Suit (4 pièces) ── */
    .suit-grid {
      display: grid;
      grid-template-columns: repeat(auto-fit, minmax(240px, 1fr));
      gap: 16px;
      margin: 22px 0;
    }
    .suit-piece {
      background: var(--glass-bg);
      backdrop-filter: var(--blur-glass);
      -webkit-backdrop-filter: var(--blur-glass);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      border-left: 3px solid var(--erina-cyan);
      padding: 22px 20px 18px;
      position: relative;
      overflow: hidden;
      transition: transform var(--transition), box-shadow var(--transition), border-color var(--transition);
      text-align: center;
    }
    .suit-piece::before {
      content: '';
      position: absolute;
      top: 0; left: 10%; right: 10%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(0,229,255,0.35), transparent);
    }
    .suit-piece:hover {
      transform: translateY(-4px);
      box-shadow: 0 8px 28px rgba(0,229,255,0.20);
    }
    .suit-icon {
      font-size: 2.6rem;
      filter: drop-shadow(0 0 12px rgba(0,229,255,0.50));
      margin-bottom: 6px;
    }
    .suit-name {
      font-size: 1rem;
      font-weight: 800;
      color: var(--text);
      margin-bottom: 6px;
    }
    .suit-effect {
      font-size: 0.78rem;
      color: var(--erina-cyan);
      font-weight: 700;
      margin-bottom: 14px;
      line-height: 1.5;
    }
    .suit-craft {
      font-size: 0.74rem;
      color: var(--text-muted);
      padding: 8px 10px;
      background: rgba(255,255,255,0.03);
      border-radius: var(--radius-md);
      border: 1px solid var(--glass-border);
    }
    .suit-craft strong {
      display: block;
      color: var(--text-faint);
      font-size: 0.62rem;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }

    /* ── Set bonus banner ── */
    .set-bonus {
      display: flex;
      gap: 16px;
      padding: 18px 22px;
      background: linear-gradient(135deg, rgba(123,47,190,0.15), rgba(0,229,255,0.10));
      border: 1px solid rgba(0,229,255,0.30);
      border-radius: var(--radius-lg);
      margin: 24px 0;
      align-items: center;
    }
    .set-bonus-icon {
      font-size: 2.4rem;
      filter: drop-shadow(0 0 10px rgba(255,215,0,0.5));
    }
    .set-bonus-text {
      font-size: 0.95rem;
      color: var(--text);
      line-height: 1.5;
    }
    .set-bonus-text strong {
      color: var(--erina-gold);
    }

    /* ── Item card (utilitaires) ── */
    .item-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(310px, 1fr));
      gap: 16px;
      margin: 22px 0;
    }
    .item-card {
      background: var(--glass-bg);
      backdrop-filter: var(--blur-glass);
      -webkit-backdrop-filter: var(--blur-glass);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      padding: 20px 20px 18px;
      position: relative;
      overflow: hidden;
      transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
    }
    .item-card::before {
      content: '';
      position: absolute;
      top: 0; left: 10%; right: 10%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.20), transparent);
    }
    .item-card:hover {
      transform: translateY(-3px);
      border-color: rgba(255,215,0,0.30);
      box-shadow: 0 8px 28px rgba(255,215,0,0.15);
    }
    .item-card-header {
      display: flex;
      gap: 12px;
      align-items: center;
      margin-bottom: 12px;
    }
    .item-card-icon {
      font-size: 2rem;
      flex-shrink: 0;
      filter: drop-shadow(0 0 8px rgba(255,215,0,0.4));
    }
    .item-card-name {
      font-size: 1.02rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.01em;
    }
    .item-card-desc {
      font-size: 0.84rem;
      color: var(--text-muted);
      line-height: 1.6;
      margin-bottom: 14px;
    }
    .item-card-craft {
      font-size: 0.74rem;
      color: var(--text-muted);
      padding: 10px 12px;
      background: rgba(255,255,255,0.03);
      border-radius: var(--radius-md);
      border: 1px solid var(--glass-border);
    }
    .item-card-craft strong {
      display: block;
      color: var(--text-faint);
      font-size: 0.62rem;
      letter-spacing: 0.07em;
      text-transform: uppercase;
      margin-bottom: 4px;
    }

    /* ── Block card (gold accent) ── */
    .item-card.block { border-left: 3px solid var(--erina-gold); }
    .item-card.block:hover { box-shadow: 0 8px 28px rgba(255,215,0,0.25); }

    /* ── Tip ── */
    .tip {
      display: flex;
      gap: 14px;
      padding: 14px 16px;
      background: rgba(0,229,255,0.06);
      border: 1px solid rgba(0,229,255,0.25);
      border-radius: var(--radius-md);
      margin: 18px 0;
    }
    .tip-icon { font-size: 1.4rem; flex-shrink: 0; }
    .tip-text { font-size: 0.86rem; color: var(--text); line-height: 1.55; }
    .tip-text strong { color: var(--erina-cyan); }

    /* ── PNG icons (replace emojis) ── */
    .suit-png {
      width: 96px;
      height: 96px;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
      filter: drop-shadow(0 0 14px rgba(0,229,255,0.55));
      margin: 0 auto 6px;
      display: block;
    }
    .item-card-png {
      width: 56px;
      height: 56px;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
      filter: drop-shadow(0 0 8px rgba(255,215,0,0.45));
      flex-shrink: 0;
    }
    .wiki-inline-icon {
      width: 18px;
      height: 18px;
      image-rendering: pixelated;
      image-rendering: crisp-edges;
      vertical-align: middle;
      margin: 0 2px;
    }
  </style>
</head>
<body>

<div class="floating-particles" aria-hidden="true"></div>
<div class="sidebar-overlay" id="sidebarOverlay"></div>
