<%- include('partials/head', { pageTitle: 'Créatures d\'Érina — EriniumFaction Wiki' }) %>
<style>
    :root {
      --erina-purple:        #7B2FBE;
      --erina-cyan:          #00E5FF;
      --erina-gold:          #FFD700;
      --mob-passive:         #2ECC71;
      --mob-hostile:         #E67E22;
      --mob-elite:           #E74C3C;
    }

    .hero-erina-mobs {
      background: linear-gradient(135deg,
        rgba(231, 76, 60, 0.12) 0%,
        rgba(123, 47, 190, 0.10) 50%,
        transparent 100%);
    }

    /* ── Mob category header ── */
    .mob-category {
      display: flex;
      align-items: center;
      gap: 14px;
      margin: 40px 0 18px;
      padding-bottom: 12px;
      border-bottom: 1px solid var(--glass-border);
    }
    .mob-category-icon { font-size: 1.8rem; flex-shrink: 0; }
    .mob-category h2 { margin: 0 !important; }
    .mob-category-count {
      margin-left: auto;
      font-size: 0.78rem;
      color: var(--text-faint);
      font-weight: 700;
      letter-spacing: 0.06em;
      text-transform: uppercase;
    }

    /* ── Mob grid ── */
    .mob-grid {
      display: grid;
      grid-template-columns: repeat(auto-fill, minmax(320px, 1fr));
      gap: 18px;
      margin: 18px 0 24px;
    }

    .mob-card {
      background: var(--glass-bg);
      backdrop-filter: var(--blur-glass);
      -webkit-backdrop-filter: var(--blur-glass);
      border: 1px solid var(--glass-border);
      border-radius: var(--radius-lg);
      padding: 20px 20px 18px;
      position: relative;
      overflow: hidden;
      transition: transform var(--transition), border-color var(--transition), box-shadow var(--transition);
    }
    .mob-card::before {
      content: '';
      position: absolute;
      top: 0; left: 10%; right: 10%;
      height: 1px;
      background: linear-gradient(90deg, transparent, rgba(255,255,255,0.20), transparent);
    }
    .mob-card:hover { transform: translateY(-3px); }

    .mob-card--passive { border-left: 3px solid var(--mob-passive); }
    .mob-card--passive:hover { box-shadow: 0 8px 28px rgba(46,204,113,0.20); }
    .mob-card--hostile { border-left: 3px solid var(--mob-hostile); }
    .mob-card--hostile:hover { box-shadow: 0 8px 28px rgba(230,126,34,0.22); }
    .mob-card--elite   { border-left: 3px solid var(--mob-elite); }
    .mob-card--elite:hover   {
      box-shadow: 0 8px 32px rgba(231,76,60,0.30);
      border-color: rgba(231,76,60,0.45);
    }

    .mob-card-header {
      display: flex;
      align-items: flex-start;
      justify-content: space-between;
      gap: 12px;
      margin-bottom: 10px;
    }
    .mob-name {
      font-size: 1.1rem;
      font-weight: 800;
      color: var(--text);
      letter-spacing: -0.01em;
    }
    .mob-icon {
      font-size: 1.8rem;
      flex-shrink: 0;
      filter: drop-shadow(0 0 8px rgba(0,229,255,0.3));
    }

    .mob-badge {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 3px 10px;
      border-radius: 100px;
      font-size: 0.66rem;
      font-weight: 800;
      text-transform: uppercase;
      letter-spacing: 0.06em;
      margin-bottom: 10px;
    }
    .mob-badge--passive {
      background: rgba(46,204,113,0.14);
      border: 1px solid rgba(46,204,113,0.35);
      color: var(--mob-passive);
    }
    .mob-badge--hostile {
      background: rgba(230,126,34,0.14);
      border: 1px solid rgba(230,126,34,0.35);
      color: var(--mob-hostile);
    }
    .mob-badge--elite {
      background: rgba(231,76,60,0.18);
      border: 1px solid rgba(231,76,60,0.45);
      color: var(--mob-elite);
      animation: elite-pulse 2.4s ease-in-out infinite;
    }
    @keyframes elite-pulse {
      0%, 100% { box-shadow: 0 0 0 rgba(231,76,60,0); }
      50%      { box-shadow: 0 0 12px rgba(231,76,60,0.5); }
    }

    /* ── HP bar ── */
    .hp-row {
      display: flex;
      align-items: center;
      gap: 10px;
      margin: 10px 0 14px;
    }
    .hp-label {
      font-size: 0.7rem;
      font-weight: 700;
      color: var(--text-faint);
      text-transform: uppercase;
      letter-spacing: 0.06em;
      min-width: 22px;
    }
    .hp-bar {
      flex: 1;
      height: 8px;
      border-radius: 100px;
      background: rgba(255,255,255,0.06);
      overflow: hidden;
      border: 1px solid rgba(255,255,255,0.08);
    }
    .hp-fill {
      height: 100%;
      background: linear-gradient(90deg, #E74C3C, #FF6B35);
      border-radius: 100px;
      box-shadow: 0 0 8px rgba(231,76,60,0.5);
    }
    .hp-val {
      font-size: 0.78rem;
      font-weight: 800;
      color: var(--text);
      min-width: 50px;
      text-align: right;
    }

    /* ── Mob stats ── */
    .mob-stats {
      display: flex;
      flex-direction: column;
      gap: 8px;
      margin: 12px 0;
      padding: 12px 14px;
      background: rgba(255,255,255,0.03);
      border-radius: var(--radius-md);
      border: 1px solid var(--glass-border);
    }
    .mob-stat-row {
      display: flex;
      align-items: baseline;
      gap: 10px;
      font-size: 0.8rem;
    }
    .mob-stat-label {
      color: var(--text-faint);
      font-weight: 700;
      min-width: 78px;
      text-transform: uppercase;
      letter-spacing: 0.05em;
      font-size: 0.66rem;
    }
    .mob-stat-val {
      color: var(--text);
      flex: 1;
      line-height: 1.4;
    }

    /* ── Drops ── */
    .drops-list {
      display: flex;
      flex-wrap: wrap;
      gap: 6px;
      margin-top: 8px;
    }
    .drop-item {
      display: inline-flex;
      align-items: center;
      gap: 5px;
      padding: 4px 10px;
      background: rgba(255,215,0,0.10);
      border: 1px solid rgba(255,215,0,0.28);
      color: var(--erina-gold);
      border-radius: 100px;
      font-size: 0.73rem;
      font-weight: 700;
    }

    /* ── Intro tip ── */
    .intro-tip {
      display: flex;
      gap: 14px;
      padding: 16px 18px;
      background: rgba(0,229,255,0.06);
      border: 1px solid rgba(0,229,255,0.25);
      border-radius: var(--radius-md);
      margin: 22px 0;
    }
    .intro-tip-icon { font-size: 1.5rem; flex-shrink: 0; }
    .intro-tip-text { font-size: 0.86rem; color: var(--text); line-height: 1.6; }
    .intro-tip-text strong { color: var(--erina-cyan); }
  </style>
</head>
